<!-- sansa-auth / pom.xml -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot parent: dependency versions managed centrally -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.3</version>
    <relativePath/>
  </parent>

  <groupId>com.sansa</groupId>
  <artifactId>sansa-auth</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>sansa-auth</name>
  <description>Sansa Auth: Registration / Login / MFA / WebAuthn / Sessions</description>
  <packaging>jar</packaging>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- ローカル既定の最低カバレッジ（CIで上書き） -->
    <coverage.min>0.00</coverage.min>

    <!-- Unmanaged by Boot parent -->
    <jjwt.version>0.12.5</jjwt.version>
    <datastax.driver.version>4.17.0</datastax.driver.version>
    <lombok.version>1.18.32</lombok.version>
  </properties>

  <!-- 依存の一元管理 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>1.20.2</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web / JSON / Validation -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Security (version managed by Boot) -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- JWT -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- Cassandra driver (optional in main artifact; added as test dep in it-cassandra profile) -->
    <dependency>
      <groupId>com.datastax.oss</groupId>
      <artifactId>java-driver-core</artifactId>
      <version>${datastax.driver.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Mail -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Commons Codec (for Base32, etc.) -->
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <version>1.16.1</version>
    </dependency>

    <!-- Lombok -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Unit test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>1.10.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- verify を既定ゴールに：常にレポート生成・チェックまで到達 -->
    <defaultGoal>verify</defaultGoal>
    <plugins>
      <!-- Java 21 / Lombok AP -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Spring Boot repack -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.sansa.auth.AuthApplication</mainClass>
        </configuration>
      </plugin>

      <!-- Unit tests (e.g., **/spec/*Test.java) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useFile>false</useFile>
          <systemPropertyVariables>
            <file.encoding>UTF-8</file.encoding>
            <sun.stdout.encoding>UTF-8</sun.stdout.encoding>
            <sun.jnu.encoding>UTF-8</sun.jnu.encoding>
            <pretty.console.ascii>false</pretty.console.ascii>
          </systemPropertyVariables>
          <includes>
            <include>**/spec/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/it/*Test.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Integration Test 専用プラグイン（failsafe）
          - surefire は単体テスト、failsafe は結合テスト(IT)を担当
          - integration-test フェーズで実行し、verify フェーズで結果判定
          - パターン: src/test/java/**/it/*Test.java を IT として拾う -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>

        <!-- フェーズ連携：IT の実行と検証 -->
        <executions>
          <execution>
            <goals>
              <!-- IT の実行（pre/post-integration-test にフックを足す場合もここで） -->
              <goal>integration-test</goal>
              <!-- IT の結果でビルド成功/失敗を確定 -->
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>

        <configuration>
          <!-- フォーク JVM の再利用。テスト起動を高速化 -->
          <reuseForks>true</reuseForks>

          <!-- IT 対象クラスの include パターン -->
          <includes>
            <include>**/it/*Test.java</include>
          </includes>

          <!-- IT 実行時に渡すシステムプロパティ
              - cassandra.keyspace / localdc はプロファイルやCIから上書き可
              - Spring 側の profile 切替は mvn -Dspring.profiles.active=... で -->
          <systemPropertyVariables>
            <cassandra.keyspace>${cassandra.keyspace}</cassandra.keyspace>
            <cassandra.localdc>${cassandra.localdc}</cassandra.localdc>
            <file.encoding>UTF-8</file.encoding>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Copy Cassandra CQLs to target for IT runs -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-cassandra-cql</id>
            <phase>generate-test-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/cassandra</outputDirectory>
              <resources>
                <resource>
                  <directory>cassandra/cql</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo: UT/IT を両方計測。verify でレポート＆閾値チェック -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <configuration>
          <!-- 必要に応じて除外を追加（自動生成/DTO/設定クラスなど） -->
          <excludes>
            <exclude>**/AuthApplication.class</exclude>
            <exclude>**/*Config.class</exclude>
            <exclude>**/*Configuration.class</exclude>
            <exclude>**/dto/**</exclude>
            <exclude>**/model/**</exclude>
            <exclude>**/*MapperImpl.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <!-- UT 用：Surefire にエージェントを注入 -->
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <!-- IT 用：Failsafe にエージェントを注入（argLine を it.argLine に出力） -->
          <execution>
            <id>prepare-agent-integration</id>
            <goals><goal>prepare-agent-integration</goal></goals>
            <configuration>
              <propertyName>it.argLine</propertyName>
            </configuration>
          </execution>
          <!-- 毎回レポート生成（HTML/XML） -->
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <!-- 閾値チェック：ローカルは0%、CIは -Dcoverage.min=1.00 で 100% 強制 -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.min}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <!-- Profiles -->
  <profiles>
    <!-- In-memory (unit tests default) -->
    <profile>
      <id>inmem</id>
      <properties>
        <spring-boot.run.profiles>inmem</spring-boot.run.profiles>
      </properties>
    </profile>

    <!-- Generic IT (still inmem unless overridden) -->
    <profile>
      <id>it</id>
      <activation>
        <property>
          <name>env.IT</name>
          <value>true</value>
        </property>
      </activation>
      <properties>
        <spring-boot.run.profiles>it</spring-boot.run.profiles>
      </properties>
    </profile>

    <!-- Cassandra IT -->
    <profile>
      <id>it-cassandra</id>

      <build>
        <plugins>
          <!-- Add dedicated test sources/resources for cassandra IT if present -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>add-test-source-cassandra</id>
                <phase>generate-test-sources</phase>
                <goals><goal>add-test-source</goal></goals>
                <configuration>
                  <sources>
                    <source>src/testCassandra/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-test-resource-cassandra</id>
                <phase>generate-test-resources</phase>
                <goals><goal>add-test-resource</goal></goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/testCassandra/resources</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- (Optional) run a tiny migrator if provided -->
          <!--
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>
              <execution>
                <id>apply-cql</id>
                <phase>pre-integration-test</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>com.sansa.auth.tools.CqlMigrator</mainClass>
                  <arguments>
                    <argument>${project.build.directory}/cassandra/sansa_auth</argument>
                    <argument>${cassandra.contactPoints}</argument>
                    <argument>${cassandra.port}</argument>
                    <argument>${cassandra.localdc}</argument>
                    <argument>${cassandra.keyspace}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          -->
        </plugins>
      </build>

      <dependencies>
        <!-- Testcontainers -->
        <dependency>
          <groupId>org.testcontainers</groupId>
          <artifactId>junit-jupiter</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.testcontainers</groupId>
          <artifactId>cassandra</artifactId>
          <scope>test</scope>
        </dependency>

        <!-- Cassandra driver for tests -->
        <dependency>
          <groupId>com.datastax.oss</groupId>
          <artifactId>java-driver-core</artifactId>
          <version>${datastax.driver.version}</version>
          <scope>test</scope>
        </dependency>

        <!-- (optional) AssertJ -->
        <dependency>
          <groupId>org.assertj</groupId>
          <artifactId>assertj-core</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>

      <properties>
        <!-- Profiles used by Spring during IT -->
        <spring-boot.run.profiles>cassandra</spring-boot.run.profiles>

        <!-- Default to production keyspace name per方針 -->
        <cassandra.keyspace>sansa_auth</cassandra.keyspace>
        <cassandra.localdc>datacenter1</cassandra.localdc>
        <!-- contact points/port are provided by Testcontainers at runtime; override as needed -->
      </properties>

      <!-- Failsafe tuning for this profile -->
    </profile>
  </profiles>
</project>
