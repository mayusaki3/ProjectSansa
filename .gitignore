################################################################################
# Project Sansa .gitignore (統合版 / コメント付き完全版)
# 目的:
#  - ビルド生成物やローカル環境依存ファイルを除外
#  - テスト資産（.eml フィクスチャ／expected_json／docs）は除外しない
#  - Maven Wrapper 等の再現性に必要なファイルは必ずコミット
################################################################################

###############################################################################
# 0) 共有ポリシー（基本方針）
###############################################################################
# ❌ 除外する: target/ やレポート、ローカルの venv・キャッシュ・ログ等 ＝ いつでも再生成できるもの
# ✅ コミットする: テストフィクスチャ（.eml / expected_json）、ドキュメント、設定テンプレート、Maven Wrapper

###############################################################################
# 1) Java / Maven / Spring Boot
###############################################################################
# Maven ビルド出力
**/target/

# テストレポート（Surefire / Failsafe）
**/surefire-reports/
**/failsafe-reports/

# JaCoCo 実行データとサイト（毎回生成される）
**/jacoco.exec
**/site/jacoco/

# 一般的なログ
*.log
hs_err_pid*.log

# Spring Boot DevTools 等が生成する一時
.springBeans
.factorypath

###############################################################################
# 2) JaCoCo の除外は POM 側で制御（ここでは生成物のみ除外）
###############################################################################
# （カバレッジしきい値は POM の coverage.min で運用。
#   ここではレポート生成物のコミット抑止のみ行う）

###############################################################################
# 3) Python（メールパーサ UT/オフライン検証向け）
###############################################################################
# 仮想環境
.venv/
venv/

# キャッシュ・カバレッジ
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.coverage
**/.coverage.*
**/htmlcov/

# Pipenv / Poetry 等（将来利用時）
Pipfile.lock
poetry.lock

###############################################################################
# 4) Node / Web / E2E（将来の追加に備え冪等で入れておく）
###############################################################################
node_modules/
**/dist/
**/.eslintcache
**/.next/
**/.nuxt/
**/.turbo/
**/coverage/

###############################################################################
# 5) Docker / MailHog / GreenMail などローカル永続化
###############################################################################
# docker-compose で作るローカルデータは除外（構成YAMLはコミット）
tools/**/data/
tools/**/logs/
docker-data/
docker-logs/

###############################################################################
# 6) IDE / エディタ / OS 依存ファイル
###############################################################################
# IntelliJ / IDEA
.idea/
*.iml
out/

# VSCode
.vscode/
# （ワークスペース共有が必要なら .vscode は別管理に）

# Mac / Windows
.DS_Store
Thumbs.db
desktop.ini

###############################################################################
# 7) 一般的な一時ファイル
###############################################################################
*.tmp
*.temp
*.swp
*.swo
*~
*.bak
*.orig

###############################################################################
# 8) 環境変数・秘密情報（テンプレート以外）
###############################################################################
# .env 類は原則コミットしない。テンプレート(.example/.template/.sample)はコミットOK
.env
.env.*
!.env.example
!.env.template
!.env.sample

###############################################################################
# 9) 「コミット必須」のものは明示的に除外解除
###############################################################################
# 9-1) テスト資産（フィクスチャ／期待JSON／ドキュメント）
#  - .eml: メールオフライン検証用（UT/パターンB）
#  - expected_json: 期待構造（テンプレートID/URL/TTLなど）
#  - docs: 公式ドキュメント（UT/IT手順、テストケース、E2E手順）
!tests/
!tests/fixtures_eml/
!tests/fixtures_eml/**
!tests/expected_json/
!tests/expected_json/**
!docs/
!docs/**

# 9-2) Maven Wrapper（再現性・CIのため必須）
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/**
!mvnw
!mvnw.cmd

# 9-3) スクリプト類（運用手順に含まれるものはコミット）
# 例: ルートの setcp.ps1 はコミット対象（※ ignore しない）
# （ここでは明示的な ignore はしない）

###############################################################################
# 10) リポジトリ個別の運用メモ
###############################################################################
# ルートの メモ.txt は仕様上コミット対象（手順で明記済み）。ignore しない。
# （必要があれば「メモ_ローカル.txt」等を各自で運用し、こちらは ignore へ追加）
